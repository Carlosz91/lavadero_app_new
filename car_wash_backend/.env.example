# Backend Configuration
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Database
MONGO_URI=mongodb://localhost:27017/car_wash

# JWT
# IMPORTANTE: en producción genera secretos largos y únicos, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Nunca uses los valores de ejemplo. Si un secreto se filtra, rótalo y todos los tokens quedan invalidados.
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_REFRESH_SECRET=change-this-to-another-random-secret-in-production

# Google Sign-In
# Web Client ID de tu proyecto Google Cloud. Verifica la audiencia (aud) de los
# idToken que la app envía a /api/auth/google. En producción es obligatorio
# (si falta, el login con Google responde SERVER_CONFIG); en desarrollo, si se
# setea, valida el aud contra este valor y rechaza tokens de otros proyectos.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# CORS
# IMPORTANTE: en producción fija los orígenes permitidos (lista separada por comas).
# Si ALLOWED_ORIGINS queda vacío/ausente, solo se permiten orígenes de desarrollo
# (http://localhost:5000, http://localhost:3000, http://localhost:5099).
# La app móvil no necesita CORS (no envía Origin), solo el panel admin (mismo origen) y dev.
# Para Railway usa el dominio del frontend web/admin, ej: https://lavaderoappnew-production.up.railway.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://10.0.2.2:5000

# Stripe (modo test)
# Obtén tu Secret Key en https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Obtén el Webhook Secret en Stripe Dashboard > Developers > Webhooks > Add endpoint
# Endpoint URL: https://tu-dominio/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# URL para redirección post-pago (10.0.2.2 para emulador Android)
STRIPE_REDIRECT_HOST=http://10.0.2.2:5000

# Rate limiting
# Límite global de peticiones por IP por ventana de 15 min (default 100).
# En desarrollo con Playwright una sola IP hace muchas peticiones: sube el valor
# solo localmente (ej: RATE_LIMIT_MAX=1000). NO definirlo en producción.
# RATE_LIMIT_MAX=1000

# Email (SMTP) para reset de contraseña
# Opcional. Sin SMTP configurado, en desarrollo el código de reset se imprime
# en los logs del backend; en producción se registra una advertencia.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_PASS=App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@lavadero.app
# URL web de restablecimiento (link incluido en el email). Opcional.
APP_RESET_URL=http://localhost:3000/reset-password
