# Variables para docker-compose (copia a .env; .env está en .gitignore).
# Genera secretos con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

MONGO_USER=carwash
MONGO_PASSWORD=

# Respaldos automáticos de MongoDB (servicio "backup")
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# Opcional: monitoreo de errores (Sentry)
SENTRY_DSN=

# Obligatorios y distintos entre sí
JWT_SECRET=
JWT_REFRESH_SECRET=

ALLOWED_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_REDIRECT_HOST=http://localhost:5000
